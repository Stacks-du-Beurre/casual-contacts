    "Close" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Close" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Закрыть" } }, "uk" : { "stringUnit" : { "state" : "translated", "value" : "Закрити" } } } },
    "Continue" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Continue" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Продолжить" } }, "uk" : { "stringUnit" : { "state" : "translated", "value" : "Продовжити" } } } },
    "Couldn't delete %@. Try again." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Couldn't delete %@. Try again." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Не удалось удалить %@. Попробуйте еще раз." } }, "uk" : { "stringUnit" : { "state" : "translated", "value" : "Не вдалося видалити %@. Спробуйте ще раз." } } } },
    "Couldn't delete contact" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Couldn't delete contact" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Не удалось удалить контакт" } }, "uk" : { "stringUnit" : { "state" : "translated", "value" : "Не вдалося видалити контакт" } } } },
    "Couldn't determine your current location. Try again with a clearer GPS signal." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Couldn't determine your current location. Try again with a clearer GPS signal." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Не удалось определить ваше текущее местоположение. Попробуйте снова при более уверенном сигнале GPS." } }, "uk" : { "stringUnit" : { "state" : "translated", "value" : "Не вдалося визначити ваше поточне місцезнаходження. Спробуйте ще раз із чіткішим сигналом GPS." } } } },
    "Done" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Done" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Готово" } }, "uk" : { "stringUnit" : { "state" : "translated", "value" : "Готово" } } } },
    "Enable location access for Casual Contacts in iOS Settings to seed nearby records." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Enable location access for Casual Contacts in iOS Settings to seed nearby records." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Разрешите доступ к геолокации для Casual Contacts в настройках iOS, чтобы добавить ближайшие тестовые записи." } }, "uk" : { "stringUnit" : { "state" : "translated", "value" : "Увімкніть доступ до геолокації для Casual Contacts у налаштуваннях iOS, щоб додати найближчі тестові записи." } } } },
    "LETTER GALLERY" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "LETTER GALLERY" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "ГАЛЕРЕЯ БУКВ" } }, "uk" : { "stringUnit" : { "state" : "translated", "value" : "ГАЛЕРЕЯ ЛІТЕР" } } } },
    "LOCATION ACCESS" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "LOCATION ACCESS" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "ДОСТУП К ГЕОЛОКАЦИИ" } }, "uk" : { "stringUnit" : { "state" : "translated", "value" : "ДОСТУП ДО ГЕОЛОКАЦІЇ" } } } },
    "Location helps Casual Contacts sort cards by where you met people, so nearby names can surface when you open the app." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Location helps Casual Contacts sort cards by where you met people, so nearby names can surface when you open the app." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Геолокация помогает Casual Contacts сортировать карточки по местам встреч, чтобы ближайшие имена появлялись при открытии приложения." } }, "uk" : { "stringUnit" : { "state" : "translated", "value" : "Геолокація допомагає Casual Contacts сортувати картки за місцями зустрічей, щоб найближчі імена з'являлися під час відкриття застосунку." } } } },
    "Location Required" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Location Required" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Требуется геолокация" } }, "uk" : { "stringUnit" : { "state" : "translated", "value" : "Потрібна геолокація" } } } },
