{
  "sourceLanguage": "en",
  "strings": {
    "CAMERA PERSPECTIVE": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CAMERA PERSPECTIVE"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ПЕРСПЕКТИВА С КАМЕРЫ"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "ПЕРСПЕКТИВА З КАМЕРИ"
          }
        }
      }
    },
    "Privacy policy — Face data and TrueDepth": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Privacy policy — Face data and TrueDepth"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Политика конфиденциальности — данные лица и TrueDepth"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Політика конфіденційності — дані обличчя й TrueDepth"
          }
        }
      }
    },
    "Enable face perspective": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable face perspective"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включить перспективу по лицу"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкнути перспективу за обличчям"
          }
        }
      }
    },
    "Continue to camera permission": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue to camera permission"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Продолжить к запросу доступа к камере"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Продовжити до запиту доступу до камери"
          }
        }
      }
    },
    "Camera for face perspective": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera for face perspective"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Камера для перспективы по лицу"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Камера для перспективи за обличчям"
          }
        }
      }
    },
    "Use camera for face perspective": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use camera for face perspective"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Использовать камеру для перспективы по лицу"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовувати камеру для перспективи за обличчям"
          }
        }
      }
    },
    "Gyro motion works without camera access. Camera mode adds perspective from your face and eye position; it does not identify you.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gyro motion works without camera access. Camera mode adds perspective from your face and eye position; it does not identify you."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Движение от гироскопа работает без доступа к камере. Режим камеры добавляет перспективу по положению лица и глаз, без идентификации."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рух від гіроскопа працює без доступу до камери. Режим камери додає перспективу за положенням обличчя й очей, без ідентифікації."
          }
        }
      }
    },
    "Enable camera in Settings": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable camera in Settings"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешить камеру в настройках"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозволити камеру в параметрах"
          }
        }
      }
    },
    "In Settings, turn on Camera, then return here and enable face perspective.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Settings, turn on Camera, then return here and enable face perspective."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В настройках разрешите доступ к камере, затем вернитесь сюда и включите перспективу по лицу."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У параметрах дозвольте доступ до камери, потім поверніться сюди й увімкніть перспективу за обличчям."
          }
        }
      }
    },
    "Camera access is restricted by your device settings.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera access is restricted by your device settings."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к камере ограничен настройками устройства."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ до камери обмежено параметрами пристрою."
          }
        }
      }
    },
    "Face perspective is unavailable on this device. Gyro motion is still available.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Face perspective is unavailable on this device. Gyro motion is still available."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перспектива по лицу недоступна на этом устройстве. Движение от гироскопа доступно."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перспектива за обличчям недоступна на цьому пристрої. Рух від гіроскопа доступний."
          }
        }
      }
    },
    "Uses gyro motion by default. Optional camera mode runs only while an enabled card view is visible.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses gyro motion by default. Optional camera mode runs only while an enabled card view is visible."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По умолчанию используется гироскоп. Необязательный режим камеры работает только пока видно представление карточек с включённой 3D-сценой."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "За замовчуванням використовується гіроскоп. Необов’язковий режим камери працює лише поки видно подання карток з увімкненою 3D-сценою."
          }
        }
      }
    },
    "Gyro only; camera off": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gyro only; camera off"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только гироскоп; камера выключена"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лише гіроскоп; камеру вимкнено"
          }
        }
      }
    },
