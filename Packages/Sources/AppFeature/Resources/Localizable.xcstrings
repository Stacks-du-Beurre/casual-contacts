    "Enable location access for Casual Contacts in iOS Settings to seed nearby records.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable location access for Casual Contacts in iOS Settings to seed nearby records."
