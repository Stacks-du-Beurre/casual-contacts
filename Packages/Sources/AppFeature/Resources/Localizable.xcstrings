        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите доступ к геолокации для Casual Contacts в настройках iOS, чтобы добавить ближайшие тестовые записи."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкніть доступ до геолокації для Casual Contacts у налаштуваннях iOS, щоб додати найближчі тестові записи."
          }
