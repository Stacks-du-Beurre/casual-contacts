    "Location helps Casual Contacts sort cards by where you met people, so nearby names can surface when you open the app.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location helps Casual Contacts sort cards by where you met people, so nearby names can surface when you open the app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Геолокация помогает Casual Contacts сортировать карточки по местам встреч, чтобы ближайшие имена появлялись при открытии приложения."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Геолокація допомагає Casual Contacts сортувати картки за місцями зустрічей, щоб найближчі імена з'являлися під час відкриття застосунку."
          }
        }
      }
    },
