    "Couldn't determine your current location. Try again with a clearer GPS signal.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't determine your current location. Try again with a clearer GPS signal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось определить ваше текущее местоположение. Попробуйте снова при более уверенном сигнале GPS."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося визначити ваше поточне місцезнаходження. Спробуйте ще раз із чіткішим сигналом GPS."
          }
        }
