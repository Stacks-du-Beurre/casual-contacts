{
  "$schema": "https://schemas.designtokens.org/draft-1/schema.json",
  "$description": "Casual Contacts marketing-site design tokens. Subset of the iOS app's design system (Packages/Sources/DesignSystem/) shaped for web consumption. W3C Design Tokens Community Group format. Source of truth: docs/site/DESIGN.md (this file's companion) and Figma node 277:11175 (color), 277:11865 (typography).",
  "color": {
    "$description": "Two parallel scales. Light L0 (lightest) → L4 (darkest light). Dark D0 (lightest dark) → D4 (darkest). Site is dark-only for v1: page bg = D4, primary text = L2.",
    "light": {
      "L0": { "$value": "#FFFFFF", "$type": "color", "$description": "Pure white. Headline text on dark." },
      "L1": { "$value": "#F4F5FA", "$type": "color" },
      "L2": { "$value": "#E9EAF1", "$type": "color", "$description": "Primary body text on dark bg." },
      "L3": { "$value": "#D0D1DA", "$type": "color", "$description": "Tertiary text, captions." },
      "L4": { "$value": "#B0B2BC", "$type": "color", "$description": "Inactive icon, fine print on dark." }
    },
    "dark": {
      "D0": { "$value": "#5F6068", "$type": "color", "$description": "Secondary text on dark." },
      "D1": { "$value": "#4A4C54", "$type": "color", "$description": "Disabled state." },
      "D2": { "$value": "#383B43", "$type": "color", "$description": "Dividers, muted borders." },
      "D3": { "$value": "#282A30", "$type": "color", "$description": "Card / surface bg, footer." },
      "D4": { "$value": "#141415", "$type": "color", "$description": "Page background (primary). Same as iOS app." }
    }
  },
  "font": {
    "family": {
      "displayHeadline": { "$value": "Cormorant SC, serif", "$type": "fontFamily" },
      "body":            { "$value": "Cormorant Infant, serif", "$type": "fontFamily" },
      "mono":            { "$value": "IBM Plex Mono, monospace", "$type": "fontFamily" }
    },
    "weight": {
      "regular":  { "$value": 400, "$type": "fontWeight" },
      "semibold": { "$value": 600, "$type": "fontWeight" },
      "bold":     { "$value": 700, "$type": "fontWeight" }
    },
    "size": {
      "$description": "Desktop sizes in px. Use clamp() for fluid scaling on smaller breakpoints; mobile values listed in docs/site/DESIGN.md §3.",
      "displayHero":   { "$value": "64px", "$type": "dimension", "$description": "Hero headline desktop." },
      "displayMobile": { "$value": "40px", "$type": "dimension", "$description": "Hero headline mobile." },
      "title":         { "$value": "33px", "$type": "dimension", "$description": "Section title." },
      "body":          { "$value": "18px", "$type": "dimension" },
      "bodySmall":     { "$value": "13px", "$type": "dimension" },
      "eyebrow":       { "$value": "12px", "$type": "dimension" },
      "mono":          { "$value": "11px", "$type": "dimension" }
    },
    "lineHeight": {
      "displayHero":   { "$value": "72px", "$type": "dimension" },
      "displayMobile": { "$value": "44px", "$type": "dimension" },
      "title":         { "$value": "40px", "$type": "dimension" },
      "body":          { "$value": "27px", "$type": "dimension" },
      "bodySmall":     { "$value": "17px", "$type": "dimension" },
      "eyebrow":       { "$value": "16px", "$type": "dimension" },
      "mono":          { "$value": "16px", "$type": "dimension" }
    },
    "tracking": {
      "$description": "Letter-spacing. Apply via CSS letter-spacing.",
      "title":     { "$value": "0",      "$type": "dimension" },
      "body":      { "$value": "-0.05em","$type": "dimension" },
      "bodySmall": { "$value": "-0.2px", "$type": "dimension" },
      "eyebrow":   { "$value": "2.4px",  "$type": "dimension" },
      "mono":      { "$value": "0",      "$type": "dimension" }
    }
  },
  "space": {
    "$description": "8 pt baseline scale. Use for padding, margins, gaps. Section spacing = space.8 desktop, space.7 mobile.",
    "1": { "$value": "4px",  "$type": "dimension" },
    "2": { "$value": "8px",  "$type": "dimension" },
    "3": { "$value": "16px", "$type": "dimension" },
    "4": { "$value": "24px", "$type": "dimension" },
    "5": { "$value": "32px", "$type": "dimension" },
    "6": { "$value": "48px", "$type": "dimension" },
    "7": { "$value": "64px", "$type": "dimension" },
    "8": { "$value": "96px", "$type": "dimension" }
  },
  "radius": {
    "sm": { "$value": "4px",  "$type": "dimension", "$description": "Chips." },
    "md": { "$value": "12px", "$type": "dimension", "$description": "Buttons." },
    "lg": { "$value": "24px", "$type": "dimension", "$description": "Card mocks." },
    "xl": { "$value": "32px", "$type": "dimension", "$description": "Hero card." }
  },
  "breakpoint": {
    "mobile":  { "$value": "320px",  "$type": "dimension" },
    "tablet":  { "$value": "768px",  "$type": "dimension" },
    "desktop": { "$value": "1024px", "$type": "dimension" }
  },
  "container": {
    "$description": "Content max-width per breakpoint. Beyond desktop the layout caps at 960px and centers.",
    "mobile":  { "$value": "100%",  "$type": "dimension" },
    "tablet":  { "$value": "720px", "$type": "dimension" },
    "desktop": { "$value": "960px", "$type": "dimension" }
  },
  "gradient": {
    "$description": "Painterly time-of-day gradients shipped as PNGs (689×416). DO NOT replace with CSS linear-gradient — the painterly bitmap texture is part of the brand. Reference by URL or copy into site/public/gradients/. Source: design-assets/Gradients/<name>.png.",
    "sunrise":  { "$value": "url('/gradients/sunrise.png')",  "$type": "gradient", "$source": "design-assets/Gradients/Sunrise.png",  "$figmaNode": "343:22" },
    "dawn":     { "$value": "url('/gradients/dawn.png')",     "$type": "gradient", "$source": "design-assets/Gradients/Dawn.png",     "$figmaNode": "343:26" },
    "midday":   { "$value": "url('/gradients/midday.png')",   "$type": "gradient", "$source": "design-assets/Gradients/Midday.png",   "$figmaNode": "10:4"   },
    "sunset":   { "$value": "url('/gradients/sunset.png')",   "$type": "gradient", "$source": "design-assets/Gradients/Sunset.png",   "$figmaNode": "10:3",   "$role": "Primary marketing accent — hero CTA, section dividers." },
    "dusk":     { "$value": "url('/gradients/dusk.png')",     "$type": "gradient", "$source": "design-assets/Gradients/Dusk.png",     "$figmaNode": "31:4"   },
    "night":    { "$value": "url('/gradients/night.png')",    "$type": "gradient", "$source": "design-assets/Gradients/Night.png",    "$figmaNode": "39:4"   },
    "midnight": { "$value": "url('/gradients/midnight.png')", "$type": "gradient", "$source": "design-assets/Gradients/Midnight.png", "$figmaNode": "343:30" }
  },
  "motion": {
    "$description": "Conservative web-only motion. Always wrap with @media (prefers-reduced-motion: reduce) { *: animation-duration: 0.01ms; }",
    "duration": {
      "fast":    { "$value": "120ms", "$type": "duration", "$description": "Hover state on CTAs." },
      "default": { "$value": "200ms", "$type": "duration", "$description": "Section fade-in on scroll." }
    },
    "easing": {
      "standard": { "$value": "cubic-bezier(0.4, 0, 0.2, 1)", "$type": "cubicBezier" }
    }
  },
  "asset": {
    "$description": "Pointers to source assets that ship in the iOS repo. Copy into site/public/ as needed during build.",
    "appIcon":  { "$value": "../CasualContacts/CasualContacts/Assets.xcassets/AppIcon.appiconset/AppIcon.png", "$type": "asset", "$figmaNode": "388:13592" },
    "wordmarkGlyphC": { "$value": "../design-assets/Blended_export/SVG/C_Circle.svg", "$type": "asset", "$description": "Line-work C — brand mark." },
    "fonts": {
      "cormorantSCBold":      { "$value": "../design-assets/fonts/CormorantSC-Bold.ttf",         "$type": "asset" },
      "cormorantSCSemibold":  { "$value": "../design-assets/fonts/CormorantSC-SemiBold.ttf",     "$type": "asset" },
      "cormorantInfantVar":   { "$value": "../design-assets/fonts/CormorantInfant-Variable.ttf", "$type": "asset" },
      "ibmPlexMonoRegular":   { "$value": "../design-assets/fonts/IBMPlexMono-Regular.ttf",      "$type": "asset" }
    }
  }
}
